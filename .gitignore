/target
/target-*
*.wav
!/assets/**/*.wav
.DS_Store
# Projects that point at sound files on this machine.
/examples/local/
# The sample pack and project the screenshots are made from: written by
# `cargo run -p trill-app --example sound_fixtures` (see screenshots/render.sh).
/crates/trill-app/screenshots/sounds/
# The held envelopes and the lost work other screenshots are made from:
# written by `cargo run -p trill-app --example window_fixtures`.
/crates/trill-app/screenshots/fixtures/
# Pictures of the window are rendered to target/screenshots and not kept;
# the README's four are in docs/images. See screenshots/render.sh.
/crates/trill-app/screenshots/*.png
# What Python leaves beside the scripts it runs.
__pycache__/
